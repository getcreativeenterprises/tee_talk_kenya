
/* ---------- Customizer ---------- */
.customizer-grid {
  display: grid;
  grid-template-columns: 340px 1fr;
  gap: 40px;
  align-items: start;
}
@media (max-width: 800px) {
  .customizer-grid { grid-template-columns: 1fr; }
}

.cz-panel { display: flex; flex-direction: column; gap: 26px; }
.cz-group label.group-label {
  display: block; font-size: 0.75rem; text-transform: none; color: #444; margin-bottom: 10px;
}
.cz-tabs { display: flex; gap: 8px; }
.cz-tab {
  flex: 1; padding: 10px; border: 1px solid var(--ink); border-radius: 4px; background: transparent;
  font-family: 'Space Mono', monospace; font-size: 0.8rem; cursor: pointer;
}
.cz-tab.active { background: var(--ink); color: var(--cream); }

.swatches { display: flex; gap: 10px; flex-wrap: wrap; }
.swatch {
  width: 34px; height: 34px; border-radius: 50%; border: 2px solid transparent; cursor: pointer;
  box-shadow: inset 0 0 0 1px var(--tan);
}
.swatch.active { border-color: var(--ink); }

.cz-input {
  width: 100%; padding: 10px 12px; border: 1px solid var(--tan); border-radius: 4px;
  font-family: 'Space Mono', monospace; font-size: 0.85rem; background: var(--oatmeal);
}
.char-count { font-size: 0.7rem; color: #888; margin-top: 4px; }

.font-options { display: flex; flex-direction: column; gap: 8px; }
.font-option {
  padding: 10px 12px; border: 1px solid var(--tan); border-radius: 4px; background: var(--oatmeal);
  cursor: pointer; text-align: left; font-size: 0.95rem;
}
.font-option.active { border-color: var(--ink); background: var(--sand); }
.font-option[data-font="mono"] { font-family: 'Space Mono', monospace; }
.font-option[data-font="script"] { font-family: 'Caveat', cursive; font-size: 1.15rem; }
.font-option[data-font="grotesk"] { font-family: 'Space Grotesk', sans-serif; }

.toggle-row { display: flex; align-items: center; justify-content: space-between; }
.toggle {
  width: 42px; height: 24px; border-radius: 12px; background: var(--tan); position: relative;
  cursor: pointer; border: none; padding: 0;
}
.toggle::after {
  content: ""; position: absolute; top: 2px; left: 2px; width: 20px; height: 20px; border-radius: 50%;
  background: var(--cream); transition: left 0.15s ease;
}
.toggle.on { background: var(--sage); }
.toggle.on::after { left: 20px; }

.cz-preview {
  background: var(--oatmeal); border: 1px solid var(--tan); border-radius: 6px;
  display: flex; align-items: center; justify-content: center; padding: 40px;
  position: relative; min-height: 480px;
}
.cz-preview svg { width: 100%; max-width: 360px; }
.cz-preview .qr-tag {
  position: absolute; bottom: 24px; right: 24px; background: var(--cream);
  border: 1px solid var(--ink); border-radius: 4px; padding: 6px 10px; font-size: 0.68rem;
}
